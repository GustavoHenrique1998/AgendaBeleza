// Banco de dados (PostgreSQL + Prisma)
//
// Convenções:
//  - Dinheiro em centavos (Int) para evitar erros de ponto flutuante.
//  - Horários de expediente em "minutos desde 00:00" (Int). Ex.: 09:00 = 540.
//  - Datas/horas de agendamentos em TIMESTAMPTZ (UTC); o fuso do salão fica em Settings.
//  - Preço e duração são "congelados" no agendamento (snapshot), para que mudar
//    o catálogo depois não altere o histórico.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // conexão do app (no Supabase: pooler, porta 6543)
  directUrl = env("DIRECT_URL")   // conexão para migrations (no Supabase: porta 5432)
}

enum Role {
  CLIENT
  ADMIN
}

enum AppointmentStatus {
  PENDING    // Pendente
  CONFIRMED  // Confirmado
  COMPLETED  // Concluído
  CANCELLED  // Cancelado
  NO_SHOW    // Falta
}

enum AppointmentSource {
  ONLINE     // cliente agendou pelo portal
  ADMIN      // dono lançou manualmente (telefone/WhatsApp)
}

// ─────────────────────────── Usuários ───────────────────────────

// email e passwordHash são opcionais: o dono pode cadastrar clientes que
// só ligam/mandam mensagem (sem login). Quem tem os dois consegue entrar.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String?  @unique
  phone        String?
  passwordHash String?
  role         Role     @default(CLIENT)
  notes        String?  // observações internas do dono sobre o cliente
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  appointments Appointment[]

  @@index([role])
}

// ─────────────────────────── Catálogo ───────────────────────────

model Category {
  id        String    @id @default(cuid())
  name      String    @unique // Cabelo, Maquiagem, Unhas, Estética...
  sortOrder Int       @default(0)
  services  Service[]
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  priceCents  Int
  durationMin Int      // duração exata: base do cálculo de disponibilidade
  bufferMin   Int      @default(0) // intervalo de preparo/limpeza após o serviço
  active      Boolean  @default(true) // "inativar" em vez de apagar
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])

  professionals       ProfessionalService[]
  appointmentServices AppointmentService[]

  @@index([categoryId, active])
}

// ─────────────────────────── Profissionais ───────────────────────────

model Professional {
  id        String   @id @default(cuid())
  name      String
  bio       String?
  photoUrl  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  services     ProfessionalService[]
  schedules    WorkSchedule[]
  timeBlocks   TimeBlock[]
  appointments Appointment[]
}

// N:N — quais serviços cada profissional executa
model ProfessionalService {
  professionalId String
  serviceId      String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([professionalId, serviceId])
}

// ─────────────────────────── Horários de trabalho ───────────────────────────

// professionalId = null  → expediente GERAL do salão naquele dia da semana.
// professionalId != null → expediente específico do profissional (ex.: Joana,
//                          Seg–Sex 09:00–18:00, almoço 12:00–13:00).
// Regra: o horário efetivo do profissional = interseção(profissional, salão).
// Um dia sem linha (ou isOpen=false) = fechado / folga semanal.
//
// Obs.: no Postgres, NULL não conflita em índice único, então a unicidade do
// expediente do salão (professionalId NULL) é garantida por um índice parcial
// criado na migration (WorkSchedule_salao_weekday_key).
model WorkSchedule {
  id             String        @id @default(cuid())
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  weekday        Int           // 0 = domingo ... 6 = sábado
  isOpen         Boolean       @default(true)
  startMin       Int           // 540 = 09:00
  endMin         Int           // 1080 = 18:00
  breakStartMin  Int?          // 720 = 12:00 (almoço)
  breakEndMin    Int?          // 780 = 13:00

  @@unique([professionalId, weekday])
  @@index([weekday])
}

// Bloqueios pontuais: folgas, férias, manutenção, feriados.
// professionalId = null → bloqueia o salão inteiro (ex.: feriado).
model TimeBlock {
  id             String        @id @default(cuid())
  professionalId String?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  startsAt       DateTime      @db.Timestamptz(3)
  endsAt         DateTime      @db.Timestamptz(3)
  reason         String?

  @@index([professionalId, startsAt, endsAt])
}

// ─────────────────────────── Agendamentos ───────────────────────────

model Appointment {
  id             String            @id @default(cuid())
  clientId       String
  client         User              @relation(fields: [clientId], references: [id])
  professionalId String
  professional   Professional      @relation(fields: [professionalId], references: [id])

  startsAt       DateTime          @db.Timestamptz(3)
  endsAt         DateTime          @db.Timestamptz(3) // startsAt + soma(duração + buffer) dos serviços
  status         AppointmentStatus @default(PENDING)
  source         AppointmentSource @default(ONLINE)
  totalCents     Int
  notes          String?
  cancelledAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  services       AppointmentService[]

  @@index([professionalId, startsAt, endsAt])
  @@index([clientId, startsAt])
  @@index([status, startsAt])
}

model AppointmentService {
  id            String      @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service     @relation(fields: [serviceId], references: [id])
  // snapshots
  name          String
  priceCents    Int
  durationMin   Int
  bufferMin     Int         @default(0)
  position      Int         @default(0)
}

// ─────────────────────────── Configurações ───────────────────────────

// Linha única (id = 1)
model Settings {
  id             Int    @id @default(1)
  timezone       String @default("America/Sao_Paulo")
  slotStepMin    Int    @default(30)  // granularidade dos horários exibidos
  minAdvanceMin  Int    @default(120) // antecedência mínima para agendar
  maxAdvanceDays Int    @default(60)  // até quantos dias à frente
  cancelMinHours Int    @default(24)  // antecedência mínima para o cliente cancelar
}
